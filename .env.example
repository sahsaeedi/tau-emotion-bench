ANTHROPIC_API_KEY=<your_key_here>
OPENAI_API_KEY=<your_key_here>

# Optional: send EVERY OpenAI-provider model (gpt-4.1 too) to an OpenAI-compatible
# server. To mix OpenAI models with another server, leave this unset and pass
# --user-api-base / --agent-api-base per run instead (see docs/models.md).
# OPENAI_API_BASE=http://localhost:8000/v1
